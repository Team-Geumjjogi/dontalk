# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)

# --- web (Flask) ---
FLASK_SECRET_KEY=change-me
AI_SERVER_URL=http://localhost:8000

# --- ai (FastAPI) ---
# 개발 초기에는 true: 실제 모델 없이 가짜(mock) 응답을 돌려줍니다.
AI_MOCK_MODE=true
EMBEDDING_MODEL=
LLM_MODEL_ID=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
LLM_ADAPTER_PATH=
VECTOR_STORE_PATH=data/processed/index
