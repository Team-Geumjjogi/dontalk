# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)

# --- web (Flask) ---
FLASK_SECRET_KEY=change-me
AI_SERVER_URL=http://localhost:8000

# --- ai (FastAPI) ---
# 개발 초기에는 true: 실제 모델 없이 가짜(mock) 응답을 돌려줍니다.
AI_MOCK_MODE=true
EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
LLM_MODEL_ID=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
LLM_ADAPTER_PATH=
VECTOR_STORE_PATH=data/processed/index

# --- 팀 공용 DB (web 과 ai 가 모두 사용) ---
# 한 DB 안에 두 종류의 테이블이 있습니다. 값은 팀원에게 받아서 .env 에 채우세요.
#   - financial_consulting_qa : RAG 지식베이스. ai 가 읽기 전용으로만 접속합니다.
#   - customer / consult / employee / message : 웹 전용 테이블. web 이 시작할 때 없으면 자동으로 만듭니다.
# 상담사/관리자 계정은 web/ 폴더에서 `flask --app app create-employee ...` 로 만듭니다 (web/app/cli.py 참고).
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require
DB_SSLNEGOTIATION=direct
# DB_CONNECT_TIMEOUT=10
# DB_TABLE=financial_consulting_qa

# --- LLM 서빙 / RAG (모두 선택. 없으면 아래 기본값) ---
# LLM_BACKEND: ollama(로컬 개발, base 모델) | transformers(GPU 서버, 팀원 model.py + 분야별 어댑터)
LLM_BACKEND=ollama
# 서버로 옮길 때는 OLLAMA_HOST 주소만 바꾸면 됩니다. 튜닝 모델을 `ollama create` 로 등록했다면 OLLAMA_MODEL 에 그 이름을.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=exaone3.5:2.4b
# OLLAMA_TIMEOUT=50
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=400
# LLM_NUM_CTX=8192
# RAG: Top-K 개수, 이관 판단 임계값 (최고 유사도 / 분야 확신도). 25개 질문 조사로 정한 초기값이라 써 보며 조정하세요.
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.55
# RAG_MIN_CONFIDENCE=0.6

# --- (사용 안 함) 예전 로컬 pgvector, docker-compose.yml ---
# 이제 web/ai 모두 위의 공용 DB(DB_*)를 씁니다. 아래 값은 로컬에서 docker-compose 를 따로 띄울 때만 필요합니다.
# 로컬 전용 DB라 민감한 값은 아니지만, 습관적으로 docker-compose.yml에 직접 쓰지 않고 여기(.env, 커밋 안 됨)서 읽어옵니다.
# POSTGRES_PORT: 로컬에 이미 Postgres(5432)가 떠 있으면 "port is already allocated" 에러가 남 -> 5433 등 다른 포트로 바꾸세요.
# (DATABASE_URL 뒤쪽 포트 번호도 같이 맞춰줘야 합니다)
POSTGRES_USER=dontalk
POSTGRES_PASSWORD=dontalk
POSTGRES_DB=dontalk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dontalk:dontalk@localhost:5432/dontalk
