# Copy to .env.server on the 3060 server and fill in. Not committed.

# Absolute paths inside WSL (ext4), e.g. /home/<user>/dontalk/models
# MODELS_DIR must contain exaone/ (EXAONE-3.5-2.4B-Instruct); ADAPTERS_DIR must contain bank/ insurance/ stock/
MODELS_DIR=/home/CHANGE_ME/dontalk/models
ADAPTERS_DIR=/home/CHANGE_ME/dontalk/adapters

VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_UTIL=0.85
# Must be >= the rank used when the adapters were trained (check adapter_config.json "r")
VLLM_MAX_LORA_RANK=16

# FastAPI (api service)
AI_PORT=8000
# Host address the api port is published on. 127.0.0.1 = only this server (web on the same host or via SSH tunnel).
# If the web server is another machine, use this server's private IP, e.g. 192.168.0.10 (not 0.0.0.0).
AI_BIND=127.0.0.1
# false = call vLLM; true = return mock answers without a model
AI_MOCK_MODE=false
# Compose-internal address (service name + container port), not the host port VLLM_PORT
VLLM_BASE_URL=http://vllm:8000/v1
# Per-request LLM timeout in seconds (browser 90 > web->AI 70 > AI: search ~22 + LLM 40)
VLLM_TIMEOUT=40

# RAG shared DB (same values as the DB_* in .env). Never commit real values.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require
DB_SSLNEGOTIATION=direct
# Empty = default embedding model (dragonkue/snowflake-arctic-embed-l-v2.0-ko)
EMBEDDING_MODEL=
