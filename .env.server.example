# Copy to .env.server on the 3060 server and fill in. Not committed.

# Absolute paths inside WSL (ext4), e.g. /home/<user>/dontalk/models
# MODELS_DIR must contain exaone/ (EXAONE-3.5-2.4B-Instruct); ADAPTERS_DIR must contain bank/ insurance/ securities/
MODELS_DIR=/home/CHANGE_ME/dontalk/models
ADAPTERS_DIR=/home/CHANGE_ME/dontalk/adapters

VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_UTIL=0.85
# Must be >= the rank used when the adapters were trained (check adapter_config.json "r")
VLLM_MAX_LORA_RANK=16

# FastAPI (api service)
AI_PORT=8000
# false = call vLLM; true = return mock answers without a model
AI_MOCK_MODE=false
# Compose-internal address (service name + container port), not the host port VLLM_PORT
VLLM_BASE_URL=http://vllm:8000/v1
